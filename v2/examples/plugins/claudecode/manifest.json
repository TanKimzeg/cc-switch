{
  "id": "claudecode",
  "name": "Claude Code",
  "version": "0.1.0",
  "apiVersion": "1",
  "author": "cc-switch",
  "description": "Claude Code TS 插件：经宿主资源白名单读写 ~/.claude/settings.json、~/.claude.json 与会话 jsonl。",
  "capabilities": {
    "readLive": true,
    "apply": true,
    "remove": true,
    "import": true,
    "sessions": true,
    "mcp": true
  },
  "resources": {
    "config": "~/.claude/settings.json",
    "mcp": "~/.claude.json",
    "projects": "~/.claude/projects"
  },
  "promptFile": "~/.claude/CLAUDE.md",
  "skillsDir": "~/.claude/skills",
  "entry": {
    "type": "ts",
    "main": "main.js"
  }
}
